{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.local/schemas/operations-registry.schema.json",
  "title": "ACOS Operations Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "service_tiers",
    "incident_severities",
    "change_classes",
    "runbooks",
    "continuity_plans",
    "services",
    "operational_invariants"
  ],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "service_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "support_model", "minimum_availability", "requires_continuity_plan", "requires_on_call"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "support_model": {"enum": ["24x7", "business-hours", "best-effort"]},
          "minimum_availability": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
          "requires_continuity_plan": {"type": "boolean"},
          "requires_on_call": {"type": "boolean"}
        }
      }
    },
    "incident_severities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "acknowledgement_minutes", "escalation_minutes", "post_incident_review_required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "acknowledgement_minutes": {"type": "integer", "minimum": 1},
          "escalation_minutes": {"type": "integer", "minimum": 1},
          "post_incident_review_required": {"type": "boolean"}
        }
      }
    },
    "change_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "approval_required", "retrospective_required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "approval_required": {"type": "boolean"},
          "retrospective_required": {"type": "boolean"}
        }
      }
    },
    "runbooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "review_interval_days", "location"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"$ref": "#/$defs/id"},
          "review_interval_days": {"type": "integer", "minimum": 1},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "continuity_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "rto_minutes", "rpo_minutes", "exercise_interval_days", "dependency_recovery_order"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"$ref": "#/$defs/id"},
          "rto_minutes": {"type": "integer", "minimum": 1},
          "rpo_minutes": {"type": "integer", "minimum": 1},
          "exercise_interval_days": {"type": "integer", "minimum": 1},
          "dependency_recovery_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "technical_owner", "environment", "service_tier", "runbooks", "slos"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"$ref": "#/$defs/id"},
          "technical_owner": {"$ref": "#/$defs/id"},
          "environment": {"enum": ["production", "staging", "development"]},
          "service_tier": {"$ref": "#/$defs/id"},
          "runbooks": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "continuity_plan": {"$ref": "#/$defs/id"},
          "slos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sli", "objective_percent", "window_days"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "sli": {"$ref": "#/$defs/id"},
                "objective_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
                "window_days": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "operational_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
