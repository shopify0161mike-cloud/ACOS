{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.enterprise/schemas/security-registry.schema.json",
  "title": "ACOS Enterprise Security Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "security_domains", "security_invariants", "exceptions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "security_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "classification", "status", "controls", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 3},
          "owner": {"type": "string", "minLength": 3},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
          "status": {"enum": ["planned", "active", "deprecated", "retired"]},
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          }
        }
      }
    },
    "security_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^SEC-INV-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 20}
        }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
