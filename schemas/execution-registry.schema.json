{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogvision.ai/schemas/execution-registry.schema.json",
  "title": "Enterprise Execution Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "architecture_chapter", "status", "owner_domain", "owner_capability", "states", "transitions", "retry_policies", "failure_classes", "compensation_definitions", "governance_invariants"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "architecture_chapter": {"const": "1.3"},
    "status": {"enum": ["draft", "approved", "canonical", "deprecated"]},
    "owner_domain": {"type": "string", "pattern": "^DOM-[A-Z]{3}-[A-Z]{3}-[0-9]{3}$"},
    "owner_capability": {"type": "string", "pattern": "^CAP-[A-Z]{3}-[A-Z]{3}-[0-9]{3}$"},
    "states": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/state"}},
    "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}},
    "retry_policies": {"type": "array", "items": {"$ref": "#/$defs/retryPolicy"}},
    "failure_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failureClass"}},
    "compensation_definitions": {"type": "array", "items": {"$ref": "#/$defs/compensation"}},
    "governance_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}, "uniqueItems": true}
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terminal"],
      "properties": {
        "id": {"type": "string", "pattern": "^EXE-STA-[A-Z_]+$"},
        "terminal": {"type": "boolean"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "trigger"],
      "properties": {
        "from": {"type": "string", "pattern": "^EXE-STA-[A-Z_]+$"},
        "to": {"type": "string", "pattern": "^EXE-STA-[A-Z_]+$"},
        "trigger": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"}
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "failure_classes", "max_attempts", "strategy", "initial_delay_seconds", "max_delay_seconds", "jitter", "deadline_seconds"],
      "properties": {
        "id": {"type": "string", "pattern": "^RETRY-[A-Z0-9-]+$"},
        "failure_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "strategy": {"enum": ["fixed", "bounded_linear", "exponential_backoff"]},
        "initial_delay_seconds": {"type": "integer", "minimum": 0},
        "max_delay_seconds": {"type": "integer", "minimum": 0},
        "jitter": {"enum": ["none", "equal", "full"]},
        "deadline_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "failureClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "retryable", "compensation_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "retryable": {"type": "boolean"},
        "compensation_required": {"type": "boolean"}
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applies_to", "reversibility", "command", "timeout_seconds", "failure_terminal_state"],
      "properties": {
        "id": {"type": "string", "pattern": "^CMP-[A-Z0-9-]+$"},
        "applies_to": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "reversibility": {"enum": ["reversible", "conditionally_reversible", "irreversible"]},
        "command": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "failure_terminal_state": {"type": "string", "pattern": "^EXE-STA-[A-Z_]+$"}
      }
    }
  }
}
