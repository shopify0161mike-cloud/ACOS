{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.local/schemas/intelligence-registry.schema.json",
  "title": "ACOS Intelligence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agents", "model_policies", "prompt_policies", "memory_policies", "knowledge_sources", "evaluation_suites", "observability_profiles"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}},
    "model_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelPolicy"}},
    "prompt_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/promptPolicy"}},
    "memory_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/memoryPolicy"}},
    "knowledge_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledgeSource"}},
    "evaluation_suites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evaluationSuite"}},
    "observability_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observabilityProfile"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "owner", "status", "risk_class", "purpose", "model_policy", "prompt_policy", "tool_scopes", "knowledge_sources", "memory_policy", "evaluation_suite", "approval_required_for", "observability_profile"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "owner": {"$ref": "#/$defs/id"},
        "status": {"enum": ["draft", "evaluation", "approved", "active", "suspended", "retired"]},
        "risk_class": {"enum": ["low", "moderate", "high", "critical"]}, "purpose": {"type": "string", "minLength": 10},
        "model_policy": {"$ref": "#/$defs/id"}, "prompt_policy": {"$ref": "#/$defs/id"},
        "tool_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "knowledge_sources": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "memory_policy": {"$ref": "#/$defs/id"}, "evaluation_suite": {"$ref": "#/$defs/id"},
        "approval_required_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "observability_profile": {"$ref": "#/$defs/id"}
      }
    },
    "modelPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "allowed_providers", "required_capabilities", "max_latency_ms", "max_cost_usd_per_run", "fallback_policy", "data_classifications"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "allowed_providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "max_latency_ms": {"type": "integer", "minimum": 1}, "max_cost_usd_per_run": {"type": "number", "minimum": 0},
        "fallback_policy": {"type": "string", "minLength": 1}, "data_classifications": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "promptPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "status", "owner", "change_control"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "status": {"enum": ["draft", "approved", "active", "retired"]}, "owner": {"$ref": "#/$defs/id"}, "change_control": {"type": "string"}}
    },
    "memoryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "classes", "retention_hours", "permitted_classifications", "persistence", "deletion"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "classes": {"type": "array", "minItems": 1, "items": {"enum": ["session", "working", "episodic", "semantic", "profile"]}, "uniqueItems": true}, "retention_hours": {"type": "integer", "minimum": 0}, "permitted_classifications": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "persistence": {"enum": ["none", "encrypted"]}, "deletion": {"type": "string"}}
    },
    "knowledgeSource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "classification", "freshness_sla_hours", "provenance_required", "access_policy"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "owner": {"$ref": "#/$defs/id"}, "classification": {"type": "string"}, "freshness_sla_hours": {"type": "integer", "minimum": 1}, "provenance_required": {"type": "boolean"}, "access_policy": {"$ref": "#/$defs/id"}}
    },
    "evaluationSuite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "required_metrics", "release_gate"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "owner": {"$ref": "#/$defs/id"}, "required_metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}, "release_gate": {"type": "string"}}
    },
    "observabilityProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "record_prompt_version", "record_model_policy", "record_tool_calls", "record_sources", "record_cost", "record_policy_decisions"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "record_prompt_version": {"type": "boolean"}, "record_model_policy": {"type": "boolean"}, "record_tool_calls": {"type": "boolean"}, "record_sources": {"type": "boolean"}, "record_cost": {"type": "boolean"}, "record_policy_decisions": {"type": "boolean"}}
    }
  }
}
