{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.dev/schemas/governance-registry.schema.json",
  "title": "ACOS Governance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registry_id", "status", "default_effect", "conflict_resolution", "authority_levels", "risk_tiers", "policies", "approval_requirements", "budget_controls", "exception_policy", "required_audit_fields"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "registry_id": {"type": "string", "minLength": 3},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "default_effect": {"enum": ["deny"]},
    "conflict_resolution": {"enum": ["explicit_deny"]},
    "authority_levels": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rank", "description"],
        "properties": {"id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "description": {"type": "string", "minLength": 1}}
      }
    },
    "risk_tiers": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "score_min", "score_max", "approval_mode"],
        "properties": {
          "id": {"type": "string"}, "score_min": {"type": "integer", "minimum": 1}, "score_max": {"type": "integer", "minimum": 1},
          "approval_mode": {"enum": ["automated", "accountable_owner", "independent_approval", "quorum"]}
        }
      }
    },
    "policies": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "owner_domain", "version", "status", "priority", "scope", "effect", "condition", "evidence_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^GOV-POL-[0-9]{3,}$"}, "name": {"type": "string"}, "owner_domain": {"type": "string"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "status": {"enum": ["draft", "active", "deprecated"]},
          "priority": {"type": "integer", "minimum": 0},
          "scope": {"type": "object", "required": ["actions", "environments"], "properties": {"actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "environments": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
          "effect": {"enum": ["allow", "deny", "require_approval", "require_control", "limit"]}, "condition": {"type": "string", "minLength": 1},
          "approval_requirement": {"type": "string"}, "controls_required": {"type": "array", "items": {"type": "string"}},
          "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "approval_requirements": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "risk_tiers", "minimum_authority", "quorum", "independent_from_requestor", "sequence", "expires_after_minutes"],
        "properties": {
          "id": {"type": "string"}, "risk_tiers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "minimum_authority": {"type": "string"},
          "quorum": {"type": "integer", "minimum": 1}, "independent_from_requestor": {"type": "boolean"},
          "sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "expires_after_minutes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "budget_controls": {"type": "object", "required": ["reservation_required_actions", "overcommit_allowed", "reservation_expiry_minutes", "reconciliation_required", "emergency_exception_policy"], "additionalProperties": false, "properties": {"reservation_required_actions": {"type": "array", "items": {"type": "string"}}, "overcommit_allowed": {"type": "boolean"}, "reservation_expiry_minutes": {"type": "integer", "minimum": 1}, "reconciliation_required": {"type": "boolean"}, "emergency_exception_policy": {"type": "string"}}},
    "exception_policy": {"type": "object", "required": ["maximum_duration_days", "owner_required", "compensating_controls_required", "automatic_renewal", "review_before_expiry_days"], "additionalProperties": false, "properties": {"maximum_duration_days": {"type": "integer", "minimum": 1}, "owner_required": {"type": "boolean"}, "compensating_controls_required": {"type": "boolean"}, "automatic_renewal": {"type": "boolean"}, "review_before_expiry_days": {"type": "integer", "minimum": 1}}},
    "required_audit_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
