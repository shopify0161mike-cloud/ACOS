flowchart LR

  classDef commerce fill:#ecfeff,stroke:#0e7490,stroke-width:1.5px,color:#0f172a;
  classDef intelligence fill:#f3e8ff,stroke:#7e22ce,stroke-width:1.5px,color:#0f172a;
  classDef governance fill:#fff1f2,stroke:#be123c,stroke-width:1.5px,color:#0f172a;
  classDef platform fill:#ecfdf5,stroke:#047857,stroke-width:1.5px,color:#0f172a;
  classDef human fill:#fff7ed,stroke:#c2410c,stroke-width:2px,color:#0f172a;
  classDef external fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#0f172a;

  HUMAN["Human Strategic Authority"]:::human

  subgraph COM["Commerce Domain Group"]
    direction TB
    PRO["Product"]:::commerce
    SUP["Supplier"]:::commerce
    FIN["Finance"]:::commerce
    BRA["Brand"]:::commerce
    MKT["Marketing"]:::commerce
    SAL["Sales and Pricing"]:::commerce
    CUS["Customer"]:::commerce
    INV["Inventory"]:::commerce
    ORD["Orders"]:::commerce
    FUL["Fulfillment"]:::commerce
    ANA["Analytics"]:::commerce
  end

  subgraph INT["Intelligence Domain Group"]
    direction TB
    MI["Market Intelligence"]:::intelligence
    SI["Specialist Intelligence"]:::intelligence
    EXE["Executive Planning and Coordination"]:::intelligence
  end

  subgraph GOV["Governance Domain Group"]
    direction TB
    PLY["Policy"]:::governance
    APR["Approval"]:::governance
    RSK["Risk"]:::governance
    BUD["Budget and Exposure"]:::governance
    AUD["Audit"]:::governance
    SEC["Security and Compliance"]:::governance
  end

  subgraph PLT["Platform Domain Group"]
    direction TB
    IDN["Identity and Access"]:::platform
    RUN["Durable Execution"]:::platform
    EVT["Enterprise Events"]:::platform
    INTEG["Integration / Anti-Corruption Layer"]:::platform
    KNW["Knowledge"]:::platform
    OBS["Observability"]:::platform
    CFG["Configuration and Deployment"]:::platform
  end

  EXT["External Providers and Channels"]:::external

  HUMAN -->|authenticated decisions| APR
