  %% Review constraints
  NOTE1["Invariant: every dependency ID must resolve to exactly one registered capability"]:::root
  NOTE2["Invariant: the directed dependency graph must remain acyclic"]:::root
  NOTE3["Invariant: governance and audit dependencies cannot be bypassed by runtime or AI"]:::root

  NOTE1 -. validates .-> COM_PRO_002
  NOTE2 -. validates .-> INT_EXE_001
  NOTE3 -. constrains .-> PLT_RUN_001
