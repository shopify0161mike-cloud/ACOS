  classDef intelligence fill:#f3e8ff,stroke:#7e22ce,stroke-width:1.5px,color:#0f172a;
  classDef governance fill:#fff1f2,stroke:#be123c,stroke-width:1.5px,color:#0f172a;
  classDef platform fill:#ecfdf5,stroke:#047857,stroke-width:1.5px,color:#0f172a;
  classDef root fill:#f8fafc,stroke:#0f172a,stroke-width:2px,color:#0f172a;

  subgraph COM["Commerce"]
    direction TB
    COM_PRO_001["CAP-COM-PRO-001\nProduct Discovery"]:::commerce
    COM_PRO_002["CAP-COM-PRO-002\nProduct Qualification"]:::commerce
    COM_SUP_001["CAP-COM-SUP-001\nSupplier Discovery"]:::commerce
    COM_SUP_002["CAP-COM-SUP-002\nSupplier Qualification"]:::commerce
    COM_FIN_001["CAP-COM-FIN-001\nUnit Economics Modeling"]:::commerce
